# 차곡 서버 설정 예시.
# 프로젝트 루트에 server.properties 로 복사한 뒤 값을 채운다.
# 비밀번호가 들어 있는 server.properties 는 커밋하지 않는다.
#
# 환경변수가 파일보다 우선한다.
#   CHAGOK_DB_HOST, CHAGOK_DB_PORT, CHAGOK_DB_NAME
#   CHAGOK_DB_USER, CHAGOK_DB_PASSWORD
#   CHAGOK_DB_SSL=true     RDS처럼 TLS가 필요할 때
#   CHAGOK_DB_URL          JDBC URL을 직접 지정할 때만 (보통은 host/port로 조립)
#   CHAGOK_SERVER_PORT, CHAGOK_TEST_MODE, CHAGOK_TEST_LOGIN_ID
server.port=9000
server.maxClients=20
db.host=127.0.0.1
db.port=3306
db.name=chagok
db.user=chagok_app
db.password=change-me
db.ssl=false
test.mode=true
test.login_id=test01
